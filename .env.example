# 大数据模型提供方（OpenAI 或兼容 DeepSeek 等）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# 双模型配置见 models.example.json / docs/模型切换.md。
# 本机现有 OPENAI_API_KEY 是 DeepSeek 的密钥，保留它；GPT 单独配置：
GPT_API_KEY=

# 数据存放位置（默认在项目 data 目录）
DATA_DIR=
DB_PATH=

# 抓取公众号文章超时（秒）
LLM_TIMEOUT=90
